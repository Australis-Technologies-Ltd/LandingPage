# Australis Energy - Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Azure Configuration
VITE_AZURE_MAPS_KEY=your_azure_maps_key_here
VITE_AZURE_STORAGE_ACCOUNT=your_storage_account_here
VITE_AZURE_STORAGE_KEY=your_storage_key_here

# Portal.API — lead capture (POST /access-request).
# The only variable the deploy workflow injects. Not a secret: VITE_ values are
# baked into the bundle at build time and are publicly readable.
# Defaults to the dev host if unset; production Portal.API is parked.
VITE_PORTAL_API_BASE_URL=https://api-dev.australis.energy

# reCAPTCHA (optional — config.ts falls back to a hardcoded public site key).
# Currently unused: no form calls the reCAPTCHA hook and nothing verifies a token.
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Azure Service Bus (if needed for client-side operations)
VITE_SERVICE_BUS_CONNECTION_STRING=your_service_bus_connection_string_here

# Application Insights (if using client-side telemetry)
VITE_APPINSIGHTS_INSTRUMENTATION_KEY=your_appinsights_key_here

# Environment
VITE_APP_ENV=development
